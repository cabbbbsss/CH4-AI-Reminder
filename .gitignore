# Xcode
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode per-user state
xcuserdata/
*.xcuserdatad
*.xcuserstate
**/project.xcworkspace/*
# ...except the SwiftPM lockfile, so a fresh clone resolves the same RevenueCat version
!**/project.xcworkspace/xcshareddata/
**/project.xcworkspace/xcshareddata/*
!**/project.xcworkspace/xcshareddata/swiftpm/
**/project.xcworkspace/xcshareddata/swiftpm/*
!**/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata

# Swift Package Manager
.build/
.swiftpm/

# macOS / OS X
.DS_Store
.AppleDouble
.LSOverride
Icon_
._*
.Spotlight-V100
.Trashes
